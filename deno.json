{
  "workspace": ["./eng", "./jsr/*"],
  "imports": {
    "@types/node": "npm:@types/node@^25.9.3"
  },
  "tasks": {
    "import": "deno run -A ./eng/main.ts import",
    "modules": "deno run -A ./eng/main.ts modules",
    "build": "deno run -A ./eng/main.ts build",
    "test": "deno run -A ./eng/main.ts test",
    "lint": "deno run -A ./eng/main.ts lint",
    "fmt": "deno run -A ./eng/main.ts fmt",
    "fmt:check": "deno run -A ./eng/main.ts fmt --check",
    "audit": "deno run -A ./eng/main.ts audit",
    "check": "deno run -A ./eng/main.ts check",
    "pack": "deno run -A ./eng/main.ts pack",
    "release:prepare": "deno run -A ./eng/main.ts release-prepare",
    "publish:bootstrap": "deno run -A ./eng/main.ts publish-bootstrap"
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": false,
    "proseWrap": "preserve",
    "useBraces": "maintain",
    "exclude": [
      ".vscode",
      "artifacts",
      "npm/*/node_modules",
      "npm/*/dist",
      "npm/*/esm",
      "npm/*/types",
      "npm/*/.test"
    ]
  }
}

{
  "name": "@neotales/darwin-keychain",
  "version": "0.0.0-alpha.1",
  "description": "macOS keychain API for Node, Bun, and Deno.",
  "keywords": [
    "darwin",
    "keychain",
    "macos",
    "osx",
    "security-framework"
  ],
  "homepage": "https://github.com/neotales/js-os",
  "bugs": {
    "url": "https://github.com/neotales/js-os/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neotales/js-os.git",
    "directory": "npm/darwin-keychain"
  },
  "files": [
    "esm",
    "types"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./esm/index.js"
    },
    "./ffi": {
      "types": "./types/ffi.d.ts",
      "import": "./esm/ffi.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test esm/*.test.js",
    "test:ffi": "node --experimental-ffi --test esm/*.test.js",
    "test:bun": "bun test ./esm",
    "test:deno": "deno test -A esm/*.test.js"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "koffi": "^2.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}

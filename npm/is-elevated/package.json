{
  "name": "@neotales/is-elevated",
  "version": "0.0.0",
  "description": "isElevated function determines if the current process is running elevated (admin/root) across windows, linux, and darwin platforms.",
  "keywords": [
    "admin",
    "elevated",
    "root",
    "std",
    "sudo",
    "windows",
    "linux",
    "darwin",
    "is-elevated"
  ],
  "homepage": "https://github.com/neotales/js-os",
  "bugs": {
    "url": "https://github.com/neotales/js-os/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neotales/js-os.git",
    "directory": "npm/is-elevated"
  },
  "files": [
    "esm",
    "types"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./esm/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test esm/*.test.js",
    "test:ffi": "node --experimental-ffi --test esm/*.test.js",
    "test:bun": "bun test ./esm",
    "test:deno": "deno test -A esm/*.test.js"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "koffi": "^2.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}

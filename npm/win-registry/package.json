{
  "name": "@neotales/win-registry",
  "version": "0.0.0-alpha.1",
  "description": "Cross-runtime Windows Registry API using runtime-specific FFI backends.",
  "keywords": [
    "advapi32",
    "cross-runtime",
    "ffi",
    "registry",
    "win32",
    "windows"
  ],
  "homepage": "https://github.com/neotales/js-os",
  "bugs": {
    "url": "https://github.com/neotales/js-os/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neotales/js-os.git",
    "directory": "npm/win-registry"
  },
  "files": [
    "esm",
    "types"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./esm/index.js"
    },
    "./registry": {
      "types": "./types/registry.d.ts",
      "import": "./esm/registry.js"
    },
    "./types": {
      "types": "./types/types.d.ts",
      "import": "./esm/types.js"
    },
    "./ffi-bun": {
      "types": "./types/ffi_bun.d.ts",
      "import": "./esm/ffi_bun.js"
    },
    "./ffi-deno": {
      "types": "./types/ffi_deno.d.ts",
      "import": "./esm/ffi_deno.js"
    },
    "./ffi-node": {
      "types": "./types/ffi_node.d.ts",
      "import": "./esm/ffi_node.js"
    },
    "./ffi-koffi": {
      "types": "./types/ffi_koffi.d.ts",
      "import": "./esm/ffi_koffi.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "pnpm run build:test && node --test .test/tests/*.test.js",
    "test:ffi": "pnpm run build:test && node --experimental-ffi --test .test/tests/*.test.js",
    "test:bun": "pnpm run build:test && bun test ./.test/tests",
    "test:deno": "pnpm run build:test && deno test -A .test/tests"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "koffi": "^2.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "name": "@neotales/win-cred",
  "version": "0.0.0-alpha.0",
  "description": "Windows Credential Manager access using runtime-specific FFI backends.",
  "keywords": [
    "credential",
    "credman",
    "ffi",
    "koffi",
    "windows"
  ],
  "homepage": "https://github.com/neotales/js-os",
  "bugs": {
    "url": "https://github.com/neotales/js-os/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neotales/js-os.git",
    "directory": "npm/win-cred"
  },
  "files": [
    "esm",
    "types"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./esm/index.js"
    },
    "./credential": {
      "types": "./types/credential.d.ts",
      "import": "./esm/credential.js"
    },
    "./types": {
      "types": "./types/types.d.ts",
      "import": "./esm/types.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test esm/*.test.js",
    "test:ffi": "node --experimental-ffi --test esm/*.test.js",
    "test:bun": "bun test esm/*.test.js",
    "test:deno": "deno test -A esm/*.test.js"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "koffi": "^2.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
